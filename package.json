{
  "name": "sabotage-motion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Motion graphics for short-form video, written in code by your coding agent",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "doctor": "node skills/sabotage-motion/template/render.mjs doctor",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:engine": "node --test --test-concurrency=1 test/determinism.test.mjs test/frames.test.mjs test/alpha.test.mjs test/scene-swap.test.mjs test/board-sheet.test.mjs",
    "test:voice": "node --test --test-concurrency=1 test/cues.test.mjs test/board-timing.test.mjs test/voice-elevenlabs.test.mjs test/voice-live.test.mjs",
    "test:mix": "node --test --test-concurrency=1 test/mix.test.mjs test/parity.test.mjs",
    "test:footage": "node --test --test-concurrency=1 test/footage.test.mjs",
    "test:repo": "node --test test/leak.test.mjs test/assets.test.mjs",
    "hooks": "node scripts/leak.mjs install"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
